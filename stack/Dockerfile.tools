# Intake, custody and OCR tools. Debian packages keep this small and auditable.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      adb ffmpeg rclone tesseract-ocr ocrmypdf poppler-utils scrcpy python3 python3-pip ca-certificates coreutils \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/tools.txt /tmp/tools.txt
RUN pip3 install --break-system-packages -r /tmp/tools.txt
WORKDIR /work
CMD ["sleep", "infinity"]
